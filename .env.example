# Copie a .env y establezca secretos propios. No hay credenciales de usuario predeterminadas.
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=
# Directorio persistente absoluto del host. Use / y una unidad en Windows.
BIB_DATA_DIR=D:/Archivos/Javier/Proyectos/Bibliotecario/bibliotecario-data
BIB_ENVIRONMENT=development
BIB_PUBLIC_ORIGIN=http://localhost:3000
BIB_COOKIE_SECURE=false
BIB_WEB_PORT=3000
BIB_API_PORT=8000
BIB_LLM_MODEL=bibliotecario-generation
LLAMA_GENERATION_BASE_URL=http://host.docker.internal:8080/v1
LLAMA_GENERATION_MODEL=openai/gpt-oss-20b-Q5_K_M.gguf
# llama.cpp sin autenticacion acepta este valor; sustituir si exige una clave.
LLAMA_GENERATION_API_KEY=local-no-key
BIB_EMBEDDING_BASE_URL=http://host.docker.internal:8081
BIB_EMBEDDING_MODEL=nomic-embed-text-v1.5.f16.gguf
BIB_EMBEDDING_DIMENSIONS=768
BIB_EMBEDDING_API_KEY=
BIB_RERANKER_BASE_URL=http://host.docker.internal:8082
BIB_RERANKER_MODEL=bge-reranker-v2-m3-Q8_0.gguf
BIB_RERANKER_API_KEY=
BIB_MODEL_TIMEOUT_SECONDS=60
BIB_SUFFICIENCY_REASONING_EFFORT=low
BIB_UPLOAD_MAX_BYTES=104857600
BIB_RETIRED_RETENTION_DAYS=90
BIB_JOB_LEASE_SECONDS=30
BIB_CONVERSION_TIMEOUT_SECONDS=180
# H6 fijara digests de las imagenes exportadas.
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
